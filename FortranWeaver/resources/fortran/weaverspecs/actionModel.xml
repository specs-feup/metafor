<?xml version="1.0"?>
<actions>

    <!-- GENERIC ACTIONS FOR ALL JOINPOINTS -->

    <!-- Replaces the current node with the given node -->
    <action name="replaceWith" return="joinpoint" tooltip="Replaces this node with the given node">
        <parameter name="node" type="joinpoint"/>
    </action>

    <!-- Removes node associated to the joinpoint from the AST -->
    <action name="detach" return="joinpoint" tooltip="Removes node associated to the joinpoint from the AST"/>

    <!-- PROGRAM -->


    <!-- FILE -->

    <!-- BINARYOPERATOR -->
    <action name="setLeft" class="binaryOperator" tooltip="Sets the left-hand side of the operation">
        <parameter name="lhs" type="expr"/>
    </action>

    <action name="setRight" class="binaryOperator" tooltip="Sets the right-hand side of the operation">
        <parameter name="rhs" type="expr"/>
    </action>

    <!-- OPENMP -->
    <action name="setClauses" class="ompConstruct" tooltip="Sets the construct's clauses">
        <parameter name="clauses" type="ompClause[]"/>
    </action>

    <action name="setLoop" class="ompLoopConstruct">
        <parameter name="loop" type="doStatement"/>
    </action>

    <action name="setBody" class="ompBlockConstruct">
        <parameter name="body" type="execution"/>
    </action>

    <action name="setDirective" class="ompConstruct">
        <parameter name="directive" type="String"/>
    </action>

    <!-- SPECIFICATION -->
    <action name="addUseStmt" class="specification" tooltip="Adds a UseStmt to a specification part. The statement is inserted at the beginning.">
        <parameter name="stmt" type="useStatement"/>
    </action>

    <!-- EXECUTION -->
    <action name="insertBegin" class="execution">
        <parameter name="stmt" type="executableStatement"/>
    </action>

    <action name="insertEnd" class="execution">
        <parameter name="stmt" type="executableStatement"/>
    </action>
</actions>